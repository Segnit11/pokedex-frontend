# Base URL of the Spring Boot backend API.
# Local: http://localhost:8080   |   Production: your Railway/Render URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clerk authentication (optional). Leave blank to run the app in public mode
# (no sign-in, favorites disabled). Get free keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
